  !--------------------------------------------------------------
  ![...]
  ![...]
  ![...]
  PROC ChangeWobj1P(
    INOUT wobjdata wobjteach,
    INOUT tooldata tcpTeach)

    VAR robtarget pTeachWobj;

    wobjteach:=wobj0;
    pTeachWobj:=CRobT(\Tool:=tcpTeach\WObj:=wobj0);
    wobjteach.uframe.trans:=pTeachWobj.trans;
    wobjteach.uframe.rot:=pTeachWobj.rot;
    !End
  ENDPROC

