%%%
  VERSION:1
  LANGUAGE:ENGLISH
%%%

MODULE instrlib(SYSMODULE,NOSTEPIN)
  ![NFC 2022.09.15]
  LOCAL CONST string stModuleName:="instrlib";

  !--------------------------------------------------------------
  ![Changes the value of a digital output signal]
  ![Derived from instuction SET, accepts as parameter a string containing the signal name]
  ![...]
  PROC SetSignal(
    string Signal)

    VAR signaldo doAlias;

    AliasIO Signal,doAlias;
    Set doAlias;
  ERROR
    RAISE ;
  ENDPROC

  !--------------------------------------------------------------
  ![Changes the value of a digital output signal]
  ![Derived from instuction RESET, accepts as parameter a string containing the signal name]
  ![...]
  PROC ResetSignal(
    string Signal)

    VAR signaldo doAlias;

    AliasIO Signal,doAlias;
    Reset doAlias;
  ERROR
    RAISE ;
  ENDPROC

  !--------------------------------------------------------------
  ![Changes the value of a digital output signal]
  ![Derived from instuction SETDO, accepts as parameter a string containing the signal name]
  ![...]
  PROC SetDOSignal(
    string Signal,
    dionum Value)

    VAR signaldo doAlias;

    AliasIO Signal,doAlias;
    SetDO doAlias,Value;
  ERROR
    RAISE ;
  ENDPROC

  !--------------------------------------------------------------
  ![Wait until a digital input is set.]
  ![Derived from instuction WAITDI, accepts as parameter a string containing the signal name]
  ![...]
  PROC WaitSignalDI(
    string stSignalDI,
    num Value
    \num MaxTime
    \VAR bool TimeFlag)

    VAR signaldi diAlias;
    VAR num nCase;

    AliasIO stSignalDI,diAlias;
    !
    nCase:=0;
    IF Present(MaxTime) nCase:=nCase+1;
    IF Present(TimeFlag) nCase:=nCase+2;
    !
    TEST nCase
    CASE 0:
      WaitDI diAlias,Value;
    CASE 1:
      WaitDI diAlias,Value\MaxTime:=MaxTime;
    CASE 2:
      WaitDI diAlias,Value\TimeFlag:=TimeFlag;
    CASE 3:
      WaitDI diAlias,Value\MaxTime:=MaxTime\TimeFlag:=TimeFlag;
    ENDTEST
  ERROR
    RAISE ;
  ENDPROC

  !--------------------------------------------------------------
  ![Wait until a digital output is set.]
  ![Derived from instuction WAITDO, accepts as parameter a string containing the signal name]
  ![...]
  PROC WaitSignalDO(
    string stSignalDO,
    num Value
    \num MaxTime
    \VAR bool TimeFlag)

    VAR signaldo doAlias;
    VAR num nCase;

    AliasIO stSignalDO,doAlias;
    !
    nCase:=0;
    IF Present(MaxTime) nCase:=nCase+1;
    IF Present(TimeFlag) nCase:=nCase+2;
    !
    TEST nCase
    CASE 0:
      WaitDO doAlias,Value;
    CASE 1:
      WaitDO doAlias,Value\MaxTime:=MaxTime;
    CASE 2:
      WaitDO doAlias,Value\TimeFlag:=TimeFlag;
    CASE 3:
      WaitDO doAlias,Value\MaxTime:=MaxTime\TimeFlag:=TimeFlag;
    ENDTEST
  ERROR
    RAISE ;
  ENDPROC

  !--------------------------------------------------------------
  ![Return a string containing the value of the number passed as parameter (nNumber);]
  ![Return string is formatted with trailing zeros "0" to satisfy the requested length (nDigit);]
  ![...]
  FUNC string fxNumToStr(
    num nNumber
    \num nDigits)

    VAR string stTemp;

    stTemp:=ValToStr(nNumber);
    IF Present(nDigits) THEN
      WHILE StrLen(stTemp)<nDigits DO
        stTemp:="0"+stTemp;
      ENDWHILE
    ENDIF
    RETURN stTemp;
  ERROR
    RETURN stEmpty;
  ENDFUNC

  !--------------------------------------------------------------
  ![Piece File Name]
  ![Return a string containing the a filename in format "pXXXX", where XXXX is nPieceNumber]
  ![...]
  FUNC string fxPieceFileName(
    num nPiece)

    VAR string stTemp;

    IF (nPiece>0 AND nPiece<=9999)=FALSE RETURN stEmpty;

    stTemp:=stTemp+"p"+fxNumToStr(nPiece\nDigits:=4);
    RETURN stTemp;
  ERROR
    RETURN stEmpty;
  ENDFUNC

  !--------------------------------------------------------------
  ![Mod Loaded]
  ![Return TRUE if module, witch name is passed by parameter, is loaded ]
  ![LIMITATION: Does NOT work with M2000 Robots]
  FUNC bool fxModLoaded(
    string stModName)

    VAR num nTemp;

    !NOTE ERROR HANDLING DOES NOIT WORK WITH M2000 ROBOTS
    nTemp:=ModTime(stModName);
    RETURN TRUE;
  ERROR
    IF ERRNO<>ERR_DIVZERO THEN
      RETURN FALSE;
    ENDIF
  ENDFUNC

  !--------------------------------------------------------------
  ![String Fix Length]
  ![Return a string of a given length, eigther by truncing or by adding spaces at the bottom  ]
  ![...]
  FUNC string fxStrFixLen(
    string str,num len)

    VAR string stTemp;

    stTemp:=str;
    IF StrLen(stTemp)>len THEN
      RETURN StrPart(stTemp,1,len);
    ELSE
      WHILE (StrLen(str)<len) AND (StrLen(str)<79) DO
        stTemp:=stTemp+" ";
      ENDWHILE
      RETURN stTemp;
    ENDIF
  ERROR
    RETURN stEmpty;
  ENDFUNC

  !--------------------------------------------------------------
  ![Loads/Update a module]
  ![...]
  ![LIMITATION: Does NOT work with M2000 Robots.  Use "LoadUpdate" instead.]
  FUNC bool fxLoadUpdMod(string stFileName,string stModName)
    VAR num nModTime;
    VAR num nFileTime;
    VAR loadsession ldId;

    IF fxModLoaded(stModName)=FALSE THEN
      Load\Dynamic,stFileName;
    ELSE
      IF FileTime(stFileName\ModifyTime)>ModTime(stModName) THEN
        StartLoad\Dynamic,stFileName,ldId;
        WaitLoad\UnloadPath:=stFileName,ldId;
      ENDIF
    ENDIF
    RETURN TRUE;
  ERROR
    RETURN FALSE;
  ENDFUNC

  !--------------------------------------------------------------
  ![Mission routine Name]
  ![Return a string containing the mission routine name]
  ![...]
  FUNC string fxMissionName(
    num nMission)

    VAR string stTemp;

    IF (nMission>Dim(stMissionNames,1)) RETURN stEmpty;
    IF (nMission<1) RETURN stEmpty;

    stTemp:=stMissionNames{nMission};
    RETURN stTemp;
  ERROR
    RETURN stEmpty;
  ENDFUNC

  !--------------------------------------------------------------
  ![Loads/Update a module]
  ![...]
  ![...]
  PROC LoadUpdate(string stFileName,string stModName)
    VAR num nModTime;
    VAR num nFileTime;
    VAR loadsession ldId;
    VAR num nErrNum:=0;

    Load\Dynamic,stFileName;

    IF nErrNum=ERR_LOADED THEN
      nFileTime:=FileTime(stFileName\ModifyTime);
      nModTime:=ModTime(stModName) ;
      IF nFileTime>nModTime THEN
        UnLoad stModName;
        StartLoad\Dynamic,stFileName,ldId;
        WaitLoad\UnloadPath:=stFileName,ldId;
      ENDIF
    ELSE
      Load\Dynamic,stFileName;
    ENDIF

  ERROR
    IF ERRNO=ERR_LOADED THEN
      nErrNum:=ERR_LOADED;
      TRYNEXT;
    ENDIF
    RAISE;
  ENDPROC
  
  !--------------------------------------------------------------
  ![Reads the value of a digital input signal.]
  ![Derived from function DINPUT, accepts as parameter a string containing the signal name]
  ![...]
  FUNC dionum ReadSignalDI(
    string Signal)

    VAR signaldi diAlias;

    AliasIO Signal,diAlias;
    RETURN DInput(diAlias);
  ERROR
    RAISE ;
  ENDFUNC

  !--------------------------------------------------------------
  ![Reads the value of a digital output signal.]
  ![Derived from function DOUTPUT, accepts as parameter a string containing the signal name]
  ![...]
  FUNC dionum ReadSignalDO(
    string Signal)

    VAR signaldo doAlias;

    AliasIO Signal,doAlias;
    RETURN DOutput(doAlias);
  ERROR
    RAISE ;
  ENDFUNC

  !--------------------------------------------------------------
  ![...]
  ![...]
  ![...]
  FUNC bool ask(
    string question)

    VAR bool answ;
    VAR num choise;

    choise:=1;
    WHILE choise>0 DO
      TPReadFK choise,question,"YES"," "," "," ","NO";
      TEST choise
      CASE 1:
        answ:=TRUE;
        choise:=-1;
      CASE 5:
        answ:=FALSE;
        choise:=-1;
      DEFAULT:
        TPErase;
      ENDTEST
    ENDWHILE
    TPErase;
    RETURN answ;
    !
  ENDFUNC

  !--------------------------------------------------------------
  ![...]
  ![...]
  ![...]
  FUNC bool CheckJpos(
    jointtarget jPos)

    CONST num delta:=0.2;
    VAR jointtarget ActjPos;

    ActjPos:=CJointT();
    IF ((Abs(jPos.robax.rax_1-ActjPos.robax.rax_1)<=delta) AND (Abs(jPos.robax.rax_2-ActjPos.robax.rax_2)<=delta) AND (Abs(jPos.robax.rax_3-ActjPos.robax.rax_3)<=delta) AND (Abs(jPos.robax.rax_4-ActjPos.robax.rax_4)<=delta) AND (Abs(jPos.robax.rax_5-ActjPos.robax.rax_5)<=delta) AND (Abs(jPos.robax.rax_6-ActjPos.robax.rax_6)<=delta)) THEN
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    ENDIF
    !End
  ENDFUNC

