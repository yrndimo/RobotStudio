%%%
  VERSION:1
  LANGUAGE:ENGLISH
%%%

MODULE wzones(SYSMODULE)
  ![NFC 2022.08.30c]
  LOCAL CONST string stModuleName:="wzones";
  !
  VAR wzstationary wzHomePos;
  VAR wzstationary wzRobCylinder;
  VAR wzstationary wzCarro1;
  VAR wzstationary wzCarro2;
  VAR wzstationary wzCNC;
  VAR wzstationary wzIspezione;
  VAR wzstationary wzMisura;
  VAR wzstationary wzOutBin;
  
  VAR wzstationary wzFrontCarro1;
  VAR wzstationary wzFrontCarro2;
  VAR wzstationary wzFrontCNC;
  VAR wzstationary wzFrontIsp;
  VAR wzstationary wzFrontMisura;
  VAR wzstationary wzFrontOut;
  
  
  
  
  
  !
  CONST jointtarget jDeltaPos:=[[1,1,1,1,1,1],[5,9E+09,9E+09,9E+09,9E+09,9E+09]];

  PROC WdzInit()
    VAR shapedata volHomePos;
    VAR shapedata volApp_A;
    VAR shapedata volApp_B;
    VAR shapedata volAppDepCNC;
    VAR shapedata volAppIsp;
    VAR shapedata volAppMeas;
    VAR shapedata volOverBin;
    VAR shapedata vol01;
    VAR shapedata vol02;
    VAR shapedata vol03;
    VAR shapedata vol04;
    VAR shapedata vol05;
    VAR shapedata vol06;
    VAR shapedata vol07;
    !
    !
    WZHomeJointDef\Inside,volHomePos,jHomePos,jDeltaPos;
    WZDOSet\Stat,wzHomePos\Inside,volHomePos,doHomePos,1;
    !
    WZHomeJointDef\Inside,volApp_A,jApp_A,jDeltaPos;
    WZDOSet\Stat,wzCarro1\Inside,volApp_A,wdoCarro1,1;
    !
    WZHomeJointDef\Inside,volApp_B,jApp_B,jDeltaPos;
    WZDOSet\Stat,wzCarro2\Inside,volApp_B,wdoCarro2,1;
    !
    WZHomeJointDef\Inside,volAppDepCNC,jAppDepCNC,jDeltaPos;
    WZDOSet\Stat,wzCNC\Inside,volAppDepCNC,wdoCNC,1;
    !
    WZHomeJointDef\Inside,volAppIsp,jAppIsp,jDeltaPos;
    WZDOSet\Stat,wzIspezione\Inside,volAppIsp,wdoIspezione,1;
    !
    WZHomeJointDef\Inside,volAppMeas,jAppMeas,jDeltaPos;
    WZDOSet\Stat,wzMisura\Inside,volAppMeas,wdoMisura,1;
    !
    WZHomeJointDef\Inside,volOverBin,jOverBin,jDeltaPos;
    WZDOSet\Stat,wzOutBin\Inside,volOverBin,wdoOutBin,1;
    !
    !
    !
    WZCylDef\Inside,vol01,[0,0,0],1200,4000;
    WZDOSet\Stat,wzRobCylinder\Inside,vol01,wdoRobCylinder,1;
    !
    WZBoxDef\Inside,vol02,[2000,300,0],[-2400,1800,800];
    WZDOSet\Stat,wzFrontCarro1\Inside,vol02,wdoCarro1,1;
    !
    WZBoxDef\Inside,vol03,[2000,-300,0],[-2400,-1500,800];
    WZDOSet\Stat,wzFrontCarro2\Inside,vol03,wdoCarro2,1;
    !
    WZBoxDef\Inside,vol04,[1500,2000,1000],[-1500,3000,2500];
    WZDOSet\Stat,wzFrontCNC\Inside,vol04,wdoCNC,1;
    !
    WZBoxDef\Inside,vol05,[-1000,-1500,900],[-2500,-200,2000];
    WZDOSet\Stat,wzFrontIsp\Inside,vol05,wdoIspezione,1;
    !
    WZBoxDef\Inside,vol06,[500,-500,0],[2000,500,2000];
    WZDOSet\Stat,wzFrontMisura\Inside,vol06,wdoMisura,1;
    !
    WZBoxDef\Inside,vol07,[1500,-2000,0],[3000,-800,2500];
    WZDOSet\Stat,wzFrontOut\Inside,vol07,wdoOutBin,1;
    !
    !
    TPErase;
    TPWrite "World Zones OK!";
    WaitTime 3;
    TPShow TP_LATEST;
    !End
  ENDPROC
ENDMODULE
