  !--------------------------------------------------------------
  ![...]
  ![...]
  ![...]
  PROC MoveRJ(
    robtarget ToPoint,
    speeddata Speed,
    zonedata Zone,
    PERS tooldata Tool
    \PERS wobjdata WObj
    \switch Reset)

    !CONST string stRoutineName:="PosRecJ";
    !
    !From "ABB Technical reference manual - RAPID Instructions, Functions and Data types" 3HAC050917-001 Revision: H
    !MoveJ [\Conc] ToPoint [\ID] Speed [\V] | [ \T] Zone [\Z] [\Inpos] Tool [\WObj] [\Corr] [\TLoad]
    IF Present(WObj) THEN
      MoveJ ToPoint,Speed,Zone,Tool\WObj:=WObj;
    ELSE
      MoveJ ToPoint,Speed,Zone,Tool;
    ENDIF
    IF Present(Reset) THEN
      PosRec_Clear;
    ELSE
      IF Present(WObj) THEN
        IF (nRecIndex>=0) AND (nRecIndex<nRecLen-1) THEN
          jRec{nRecIndex}:=ToPoint;
          tRec{nRecIndex}:=Tool;
          wRec{nRecIndex}:=WObj;
        ENDIF
      ELSE
        IF (nRecIndex>=0) AND (nRecIndex<nRecLen-1) THEN
          jRec{nRecIndex}:=ToPoint;
          tRec{nRecIndex}:=Tool;
          wRec{nRecIndex}:=wobj0;
        ENDIF
      ENDIF
      Incr nRecIndex;
    ENDIF
  ENDPROC

  PROC MoveRAbsJ(
    jointtarget ToJointPos,
    speeddata Speed,
    zonedata Zone,
    PERS tooldata Tool
    \PERS wobjdata WObj
    \switch Reset)

    !CONST string stRoutineName:="PosRecJ";
    !
    !From "ABB Technical reference manual - RAPID Instructions, Functions and Data types" 3HAC050917-001 Revision: H
    !MoveJ [\Conc] ToPoint [\ID] Speed [\V] | [ \T] Zone [\Z] [\Inpos] Tool [\WObj] [\Corr] [\TLoad]
    IF Present(WObj) THEN
      MoveAbsJ ToJointPos,Speed,Zone,Tool\WObj:=WObj;
    ELSE
      MoveAbsJ ToJointPos,Speed,Zone,Tool;
    ENDIF
    IF Present(Reset) THEN
      PosRec_Clear;
    ELSE
      IF (nRecIndex>=0) AND (nRecIndex<nRecLen-1) THEN
        AbsjRec{nRecIndex}:=ToJointPos;
        tRec{nRecIndex}:=Tool;
      ENDIF
      Incr nRecIndex;
    ENDIF
  ENDPROC

  PROC MoveRL(
    robtarget ToPoint,
    speeddata Speed,
    zonedata Zone,
    PERS tooldata Tool
    \PERS wobjdata WObj
    \switch Reset)

    !CONST string stRoutineName:="PosRecL";
    !
    !From "ABB Technical reference manual - RAPID Instructions, Functions and Data types" 3HAC050917-001 Revision: H
    !MoveL [\Conc] ToPoint [\ID] Speed [\V] | [ \T] Zone [\Z] [\Inpos] Tool [\WObj] [\Corr] [\TLoad]
    IF Present(WObj) THEN
      MoveL ToPoint,Speed,Zone,Tool\WObj:=WObj;
    ELSE
      MoveL ToPoint,Speed,Zone,Tool;
    ENDIF
    IF Present(Reset) THEN
      PosRec_Clear;
    ELSE
      IF Present(WObj) THEN
        IF (nRecIndex>=0) AND (nRecIndex<nRecLen-1) THEN
          lRec{nRecIndex}:=ToPoint;
          tRec{nRecIndex}:=Tool;
          wRec{nRecIndex}:=WObj;
        ENDIF
      ELSE
        IF (nRecIndex>=0) AND (nRecIndex<nRecLen-1) THEN
          lRec{nRecIndex}:=ToPoint;
          tRec{nRecIndex}:=Tool;
          wRec{nRecIndex}:=wobj0;
        ENDIF
      ENDIF
      Incr nRecIndex;
    ENDIF
  ENDPROC

  PROC MoveRC(
    robtarget CirPoint,
    robtarget ToPoint,
    speeddata Speed,
    zonedata Zone,
    PERS tooldata Tool
    \PERS wobjdata WObj
    \switch Reset)

    !From "ABB Technical reference manual - RAPID Instructions, Functions and Data types" 3HAC050917-001 Revision: H
    !MoveC [\Conc] CirPoint ToPoint [\ID] Speed [\V] | [\T] Zone [\Z] [\Inpos] Tool [\WObj] [\Corr] [\TLoad]
    IF Present(WObj) THEN
      MoveC CirPoint,ToPoint,Speed,Zone,Tool\WObj:=WObj;
    ELSE
      MoveC CirPoint,ToPoint,Speed,Zone,Tool;
    ENDIF
    IF Present(Reset) THEN
      PosRec_Clear;
    ELSE
      IF Present(WObj) THEN
        IF (nRecIndex>=0) AND (nRecIndex<nRecLen-1) THEN
          lRec{nRecIndex}:=ToPoint;
          tRec{nRecIndex}:=Tool;
          wRec{nRecIndex}:=WObj;
        ENDIF
      ELSE
        IF (nRecIndex>=0) AND (nRecIndex<nRecLen-1) THEN
          lRec{nRecIndex}:=ToPoint;
          tRec{nRecIndex}:=Tool;
          wRec{nRecIndex}:=wobj0;
        ENDIF
      ENDIF
      Incr nRecIndex;
    ENDIF
    !
  ENDPROC

  !--------------------------------------------------------------
  ![...]
  ![...]
  ![...]
  PROC PosRec_Clear()
    !----------------------------------------
    FOR i FROM nRecLen TO 1 DO
      AbsjRec{i}:=jEmpty;
      jRec{i}:=pEmpty;
      lRec{i}:=pEmpty;
      tRec{i}:=tEmpty;
      wRec{i}:=wEmpty;
    ENDFOR
    !----------------------------------------
    nRecIndex:=1;
  ENDPROC

  !--------------------------------------------------------------
  ![...]
  ![...]
  ![...]
  PROC MoveRec_Home()
    !----------------------------------------
    IF nRecIndex<2 RETURN;
    !----------------------------------------
    FOR i FROM nRecIndex TO 1 STEP -1 DO
      AbsjTemp:=AbsjRec{i};
      lTemp:=lRec{i};
      jTemp:=jRec{i};
      tTemp:=tRec{i};
      wTemp:=wRec{i};
      !----------------------------------------
      IF lTemp<>pEmpty THEN
        MoveL lTemp,v50,fine,tTemp\WObj:=wTemp;
      ELSEIF jTemp<>pEmpty THEN
        MoveJ jTemp,v50,fine,tTemp\WObj:=wTemp;
      ELSEIF AbsjTemp<>jEmpty THEN
        MoveAbsJ AbsjTemp,v50,fine,tTemp\WObj:=wTemp;
      ENDIF
      !----------------------------------------
    ENDFOR
    PosRec_Clear;
    !----------------------------------------
  ENDPROC

  !--------------------------------------------------------------
ENDMODULE
